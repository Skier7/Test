[meta]
name = bretzz
version = 1
weather = default
ambience = none

[weather:default]
kind = sunny
longitudinal_wind_mps = 0
lateral_wind_mps = 0
air_density = 1.225
drafting_factor = 1
temperature_c = 22
humidity = 0.45
pressure_kpa = 101.325
visibility_m = 20000
rain_gain = 0
wind_gain = 0
storm_gain = 0

[room:outdoor_default]
room_preset = outdoor_open
reverb_gain = 0.1

