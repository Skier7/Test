[meta]
name = Kansas Speedway. Located in Kansas city Kansas, this is a 1.5 mile racetrack where the speeds are quick, and the racing is exciting! It produced the closest finish in Nascar history!
version = 1
weather = default
ambience = noambience

[weather: default]
kind = sunny
longitudinal_wind_mps = 0
lateral_wind_mps = 0
