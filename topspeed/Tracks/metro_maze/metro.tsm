[meta]
name = Metro Maze Underground
version = 1.0
weather = underground
ambience = none

[weather:underground]
kind = sunny
temperature_c = 19
humidity = .72
visibility_m = 12000
longitudinal_wind_mps = 0
lateral_wind_mps = 0
rain_gain = 0
wind_gain = .15
storm_gain = 0

[room:maintenance]
room_preset = tunnel_concrete
reverb_gain = .72
late_reverb_gain = .76

[room:station]
room_preset = subway_station
reverb_gain = .68

[sound_ambient:railhum]
path = Audio/rail_hum.ogg
loop = true
spatial = false
volume = .4

[sound_random:subwayrattle]
variant_paths = Audio/train1.ogg, Audio/train2.ogg, Audio/train3.ogg
loop = true
random_mode = perarea
spatial = true
allow_hrtf = true
volume = .6
start_area = s7
end_area = s13

[sound_static:fan]
path = Audio/fan.ogg
loop = true
spatial = true
position = 15,6,-30
volume = .5

[segment:s1]
type = easy_left
surface = asphalt
length = 170
width = 9
room = maintenance
sound_sources = railhum

[segment:s2]
type = hard_right
surface = asphalt
length = 150
width = 8
room = maintenance

[segment:s3]
type = hard_left
surface = asphalt
length = 150
width = 8
room = maintenance

[segment:s4]
type = easy_right
surface = asphalt
length = 140
width = 8
room = maintenance

[segment:s5]
