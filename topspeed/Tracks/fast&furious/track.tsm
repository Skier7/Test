[meta]
name = fast&furious
version = 1
weather = default
ambience = none

[weather:default]
kind = rain
longitudinal_wind_mps = 1
lateral_wind_mps = 2
air_density = 1.24
drafting_factor = 1
temperature_c = 15
humidity = 0.9
pressure_kpa = 100.5
visibility_m = 5000
rain_gain = 0.7
wind_gain = 0.2
storm_gain = 0

[room:outdoor_default]
room_preset = outdoor_open
reverb_gain = 0.1

[segment:seg1]
type = straight
surface = gravel
noise = none
length = 500
width = 10
height = 0
room = outdoor_default

[segment:seg2]
type = straight
surface = water
noise = none
length = 2000
width = 10
height = 0
room = outdoor_default

[segment:seg3]
type = straight
surface = gravel
noise = none
length = 5000
width = 10
height = 0
room = outdoor_default
