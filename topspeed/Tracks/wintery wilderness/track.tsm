[meta]
name = wintery wilderness
version = 1
weather = default
ambience = none

[weather:default]
kind = wind
longitudinal_wind_mps = 5
lateral_wind_mps = 7
air_density = 1.225
drafting_factor = 1
temperature_c = 18
humidity = 0.5
pressure_kpa = 101.0
visibility_m = 18000
rain_gain = 0
wind_gain = 0.7
storm_gain = 0

[room:outdoor_default]
room_preset = outdoor_open
reverb_gain = 0.1

