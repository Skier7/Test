[meta]
name = Nashville Fairgrounds. Nashville Fairgrounds is a half mile racetrack where hard nosed racing is the name of the game. While Nascar hasn't raced there since 1984, this is still an active racetrack by other series. Worried about the traffic and noise of the engines, The opposition by residents of Nashville is one of the reasons this track hasn't returned to the schedule. Go ahead, prove them right! 
version = 1
weather = default
ambience = noambience

[weather: default]
kind = sunny
longitudinal_wind_mps = 0
lateral_wind_mps = 0
air_density = 1.225
drafting_factor = 0.7
temperature_c = 22
humidity = 0.45
pressure_kpa = 101.325
visibility_m = 20000
rain_gain = 0
wind_gain = 0
storm_gain = 0
[sound_ambient:cars]
