[meta]
name = Road America. This track is just over 4 miles in length. It's located in Wisconsin, and only the best of the best road racers have won here.
version = 1
weather = default
ambience = noambience

[weather: default]
kind = sunny
longitudinal_wind_mps = 0
lateral_wind_mps = 0
air_density = 1.201
drafting_factor = 0.7
temperature_c = 30
humidity = 0.45
pressure_kpa = 101.325
visibility_m = 20000
rain_gain = 0
wind_gain = 0
storm_gain = 0
[sound_ambient:cars]
path = road.ogg
loop = true
volume = 0.6
spatial = false
Global = True

[room: outdoor_default]
